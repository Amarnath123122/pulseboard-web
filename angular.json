{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "pulseboard": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/pulseboard",
      "sourceRoot": "projects/pulseboard/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/pulseboard",
            "index": "projects/pulseboard/src/index.html",
            "browser": "projects/pulseboard/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/pulseboard/tsconfig.app.json",
            "assets": [
              "projects/pulseboard/src/favicon.ico",
              "projects/pulseboard/src/assets",
              {
                "glob": "staticwebapp.config.json",
                "input": "projects/pulseboard",
                "output": "/"
              }
            ],
            "styles": [
              "projects/pulseboard/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/pulseboard/src/environments/environment.ts",
                  "with": "projects/pulseboard/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "pulseboard:build:production"
            },
            "development": {
              "buildTarget": "pulseboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "pulseboard:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/pulseboard/tsconfig.spec.json",
            "assets": [
              "projects/pulseboard/src/favicon.ico",
              "projects/pulseboard/src/assets"
            ],
            "styles": [
              "projects/pulseboard/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
    "data-access": {
      "projectType": "library",
      "root": "projects/data-access",
      "sourceRoot": "projects/data-access/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/data-access/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/data-access/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/data-access/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/data-access/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}